# FindIt Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/findit
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/findit?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/findit

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
